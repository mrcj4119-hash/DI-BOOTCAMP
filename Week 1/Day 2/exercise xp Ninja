# Exercise 3: Working on a paragraph
paragraph = (
	"Learning Python rewards curiosity. Small experiments turn abstract ideas "
	"into practical understanding. Each mistake gives you a clue about what to "
	"try next, and steady practice makes difficult problems feel manageable."
)
sentences = [sentence for sentence in re.split(r"(?<=[.!?])\s+", paragraph) if sentence]
words = re.findall(r"\b[\w']+\b", paragraph.lower())
unique_words = set(words)
non_whitespace_characters = len("".join(paragraph.split()))
print("\nParagraph analysis:")
print("Characters:", len(paragraph))
print("Sentences:", len(sentences))
print("Words:", len(words))
print("Unique words:", len(unique_words))
print("Non-whitespace characters:", non_whitespace_characters)
print("Average words per sentence:", len(words) / len(sentences))
print("Non-unique words:", len(words) - len(unique_words))

# Exercise 4: Frequency of the words
text = input("Enter a sentence to count word frequencies: ")
frequency = {}
for word in text.split():
	frequency[word] = frequency.get(word, 0) + 1
for word in sorted(frequency):
	print(f"{word}:{frequency[word]}")
