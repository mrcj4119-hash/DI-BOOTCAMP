# A float stores a number with a decimal part; an integer stores a whole number.
mixed_numbers = [number / 2 for number in range(3, 11)]
print("Mixed numbers:", mixed_numbers)

print("Numbers from 1 to 20:")
for number in range(1, 21):
	print(number)

print("Numbers at even indexes:")
for index, number in enumerate(range(1, 21)):
	if index % 2 == 0:
		print(number)

while True:
	user_name = input("Enter your name: ").strip()
	if not user_name.isdigit() and len(user_name) >= 3:
		print("Thank you")
		break
	print("Please enter a proper name with at least 3 letters.")

favorite_fruits = input("Enter your favorite fruits, separated by spaces: ").lower().split()
chosen_fruit = input("Enter the name of a fruit: ").strip().lower()
if chosen_fruit in favorite_fruits:
	print("You chose one of your favorite fruits! Enjoy!")
else:
	print("You chose a new fruit. I hope you enjoy it!")

toppings = []
while True:
	topping = input("Enter a pizza topping, or type 'quit': ").strip()
	if topping.lower() == "quit":
		break
	toppings.append(topping)
	print(f"Adding {topping} to your pizza.")

total_price = 10 + len(toppings) * 2.50
print("Toppings:", toppings)
print(f"Total cost: ${total_price:.2f}")

family_size = int(input("How many family members need tickets? "))
total_cost = 0
for member_number in range(1, family_size + 1):
	age = int(input(f"Enter the age of person {member_number}: "))
	if age < 3:
		total_cost += 0
	elif age <= 12:
		total_cost += 10
	else:
		total_cost += 15
print(f"Total ticket cost: ${total_cost:.2f}")

# Bonus: restricted movie attendees
teenager_count = int(input("How many people want to see the restricted movie? "))
attendees = []
for person_number in range(1, teenager_count + 1):
	age = int(input(f"Enter the age of person {person_number}: "))
	if 16 <= age <= 21:
		attendees.append(age)
print("Allowed attendees:", attendees)
